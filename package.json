{
  "name": "studio-admin",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check:biome": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "eval:drafter": "vitest run tests/unit/drafter.eval.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && biome check vitest.config.ts playwright.config.ts tests/ && npm run test:unit && npm run test:e2e",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
